# Copy to .env (or run `make env`, which also appends the generated secrets at
# the bottom). Values here are read by docker-compose.yaml; a variable exported
# in your shell overrides the file, e.g.
#   DATA_NODE_MEM_LIMIT=2g docker compose up -d data-node

# ---- Airflow -------------------------------------------------------------
AIRFLOW_VERSION=3.3.2
AIRFLOW_IMAGE_NAME=airflow-roi:latest
AIRFLOW_PORT=8080
AIRFLOW_PUBLIC_URL=http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ---- Data node (holds the datasets, runs the in-memory factorization) -----
# Docker size syntax: 512m, 4g, 16g ... This is the knob the memory-cap tests
# are about. memswap_limit is tied to the same value, so there is no swap
# escape hatch: exceeding it gets the task OOM-killed, which Airflow reports
# as a failed task.
DATA_NODE_MEM_LIMIT=8g
DATA_NODE_CPUS=4
DATA_NODE_THREADS=4
# Celery tasks run at once on the data node. Keep at 1 so the memory estimate
# made by the `plan` task refers to the whole cap.
DATA_NODE_CONCURRENCY=1

# ---- Compute workers (classification and other light tasks) ----------------
COMPUTE_WORKER_REPLICAS=2
COMPUTE_WORKER_MEM_LIMIT=3g
COMPUTE_WORKER_CPUS=2
COMPUTE_WORKER_THREADS=2
COMPUTE_WORKER_CONCURRENCY=2

# ---- Everything else ------------------------------------------------------
AIRFLOW_SERVICE_MEM_LIMIT=2g
POSTGRES_MEM_LIMIT=1g
REDIS_MEM_LIMIT=512m
DASHBOARD_MEM_LIMIT=1g
DASHBOARD_PORT=8090
NODE_POLL_SECONDS=5
FLOWER_PORT=5555
FLOWER_PUBLIC_URL=http://localhost:5555

# ---- Host directories mounted into the nodes -------------------------------
# Point DATASETS_DIR at real data to process it (read-write: results of the
# synthetic generator land here too).
DATASETS_DIR=./data/datasets
RESULTS_DIR=./data/results
MODELS_DIR=./data/models

# ---- Appended by `make env` -------------------------------------------------
# AIRFLOW_UID=<your uid>
# FERNET_KEY=<random>
# AIRFLOW__API_AUTH__JWT_SECRET=<random>
